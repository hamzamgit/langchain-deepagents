# Application
APP_NAME=AI Customer Support Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# Database (PostgreSQL for production / Docker; SQLite for local tests)
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support_db

# LLM provider (OpenAI-compatible; works with OpenAI or OpenRouter)
LLM_API_KEY=your-api-key-here
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.0

# LangSmith observability (optional — app works without it)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-customer-support
LANGCHAIN_TRACING_V2=false

# Appears on every LangSmith trace/tag — bump when agent behavior changes
AGENT_VERSION=v1

# Checkpoint / HITL persistence
CHECKPOINT_DB_PATH=./data/checkpoints.db
KNOWLEDGE_DIR=./knowledge
